# sltp-tg-bot environment template.
# Copy to `.env` and fill in real values; never commit `.env` itself.

# Telegram bot token from @BotFather
BOT_TOKEN=8765462512:AAHXJOqieSih3nL5vZ5Y3y9fC-n4xGGtO9c

# Your Telegram numeric ID. Auto-created as admin on first /start.
ADMIN_USER_ID=8569801952

# Public HTTPS URL of the bridge (used by EA configuration / docs).
BRIDGE_PUBLIC_URL=https://bulksltp.duckdns.org

# Where the SQLite database lives (and where backups read from).
DB_PATH=/home/tamdang/apps/Trading_BulkSLTP/data/sltp.db

# Bridge HTTP listen address. Keep on localhost; nginx fronts public TLS.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8081

# Logging verbosity: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# How long the bot waits for an EA to report a job result before marking
# it expired (seconds).
JOB_TIMEOUT_SECONDS=30

# Maximum acceptable EA heartbeat staleness (seconds).
HEARTBEAT_TIMEOUT_SECONDS=60
